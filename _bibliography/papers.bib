@unpublished{Bodisz.2026,
  title={The DeFi Dilemma},
  year={2026},
  note={with <a href="https://homepage.univie.ac.at/nikolaus.hautsch/">Nikolaus Hautsch</a> and <a href="https://voigtstefan.me">Stefan Voigt</a>},
  abstract={Decentralized finance (DeFi) relies on two building blocks for settlement without trusted intermediaries: public visibility of pending transactions and transaction-fee-based execution priority. 
          We show that these building blocks jointly create front-running risk that deters submission of common-value transactions. 
          The mechanism is analogous to the information production paradox of Grossman and Stiglitz (1980). 
          Because any participant can observe and outbid the originator of a common-value transaction, the originator is not compensated for producing and submitting it in equilibrium. 
          Using granular data on prices and transactions across decentralized exchanges, we document that cross-exchange price differences are large and persistent. 
          Transaction fees consume nearly all realized arbitrage profits, consistent with rent dissipation through front-running competition. 
          Overcoming these inefficiencies is possible only by reintroducing centralized intermediation, undermining the foundational premise of DeFi.},
  preview={front_running_visual.png},
  selected={true}
}
